---
import { ClientRouter } from 'astro:transitions';
import { applyInitialTheme } from '../scripts/theme-bootstrap';
import { cfg, config, t, url, absolute, json, isoDate } from '../lib/site';
import { getPosts, getPages, contentPath, type Post } from '../lib/content';
import { runtimeConfig } from '../lib/runtime-config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import Overlays from '../components/Overlays.astro';
import Capsule from '../components/Capsule.astro';
import '@fortawesome/fontawesome-free/css/all.min.css';
import 'katex/dist/katex.min.css';
import '../styles/main.css';
import layerOrder from '../styles/layers.css?inline';
import aboutStyle from '../styles/pages/about.css?url';
import brevityStyle from '../styles/pages/brevity.css?url';
import '../styles/astro.css';
import '../styles/custom.css';

interface Props {
  title?: string;
  description?: string;
  type?: string;
  post?: Post;
  page?: import('../lib/page-types').PageMetadata;
  toc?: boolean;
}

const {
  title = config.title,
  description = config.description,
  type = 'page',
  post,
  page = {},
  toc = false,
} = Astro.props;

const posts = await getPosts(),
  pages = await getPages();
const runtime = runtimeConfig(posts, pages, { ...page, type });
const pageConfig = {
  is_post: Boolean(post),
  is_page: type !== 'solitude' && !post,
  is_home: type === 'solitude',
  page: type,
  toc: page.toc !== false && Boolean(post || type === 'page'),
  comment: page.comment !== false,
  color: page.color ?? false,
};

const vars = {
  'solitude-theme-light': cfg.theme_color.light,
  'solitude-theme-dark': cfg.theme_color.dark,
  'solitude-nav-hover-light': cfg.theme_color.nav_hover_text.light,
  'solitude-nav-hover-dark': cfg.theme_color.nav_hover_text.dark,
  'solitude-font-size': cfg.font.font_size,
  'solitude-code-font-size': cfg.font.code_font_size,
  'solitude-font-family': cfg.font.font_family,
  'solitude-code-font-family': cfg.font.code_font_family,
  'solitude-index-columns': String(cfg.index_post_list.column),
};

const inlineVars = Object.entries(vars)
  .map(([key, value]) => `--${key}:${value}`)
  .join(';');

const canonicalUrl = post
  ? absolute(contentPath(post))
  : new URL(Astro.url.pathname, config.site).href;

const ogImage = post?.data.cover ?? page.cover ?? cfg.site.icon;
const resolvedOgImage = ogImage ? absolute(ogImage) : undefined;
const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname === '';
const pageTitle = isHomePage
  ? config.title
  : title && title !== config.title
    ? `${title} | ${config.title}`
    : `${title}`;

const jsonLd = post
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl,
      },
      headline: post.data.title,
      description: description,
      image: resolvedOgImage ? [resolvedOgImage] : undefined,
      datePublished: isoDate(post.data.date),
      dateModified: isoDate(post.data.updated || post.data.date),
      author: {
        '@type': 'Person',
        name: config.author.name,
      },
      publisher: {
        '@type': 'Organization',
        name: config.title,
        logo: {
          '@type': 'ImageObject',
          url: absolute(cfg.site.icon),
        },
      },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: config.title,
      url: config.site,
      description: config.description,
      author: {
        '@type': 'Person',
        name: config.author.name,
      },
    };
---

<!doctype html>
<html lang={config.locale} data-theme="light" style={inlineVars}>
  <head>
    <style is:inline set:html={layerOrder}></style>
    {type === 'about' && <link rel="stylesheet" href={aboutStyle} />}
    {type === 'brevity' && <link rel="stylesheet" href={brevityStyle} />}
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={config.author.name} />
    <meta
      name="robots"
      content={type === '404'
        ? 'noindex, nofollow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={config.title}
      href={url('/index.xml')}
    />
    <link rel="icon" href={url(cfg.site.icon)} />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content={config.title} />
    <meta property="og:title" content={title || config.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={post ? 'article' : 'website'} />
    <meta property="og:locale" content={config.locale.replace('-', '_')} />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    {post && (
      <>
        <meta property="article:published_time" content={isoDate(post.data.date)} />
        {post.data.updated && (
          <meta property="article:modified_time" content={isoDate(post.data.updated)} />
        )}
        <meta property="article:author" content={config.author.name} />
        {post.data.categories?.map((cat: string) => (
          <meta property="article:section" content={cat} />
        ))}
        {post.data.tags?.map((tag: string) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title || config.title} />
    <meta name="twitter:description" content={description} />
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}

    <!-- Search Engine Webmaster Verification Meta Tags -->
    {process.env.GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={process.env.GOOGLE_SITE_VERIFICATION} />
    )}
    {process.env.BING_SITE_VERIFICATION && (
      <meta name="msvalidate.01" content={process.env.BING_SITE_VERIFICATION} />
    )}
    {process.env.BAIDU_SITE_VERIFICATION && (
      <meta name="baidu-site-verification" content={process.env.BAIDU_SITE_VERIFICATION} />
    )}
    {process.env.SHENMA_SITE_VERIFICATION && (
      <meta name="shenma-site-verification" content={process.env.SHENMA_SITE_VERIFICATION} />
    )}

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {cfg.pwa.enable && (
      <>
        <link rel="manifest" href={url(cfg.pwa.manifest)} />
        <meta name="theme-color" content={cfg.pwa.theme_color} />
        <meta name="mobile-web-app-capable" content="yes" />
        <link
          rel="apple-touch-icon"
          sizes="180x180"
          href={url(cfg.pwa.apple_touch_icon)}
        />
        <link
          rel="mask-icon"
          href={url(cfg.pwa.mask_icon)}
          color={cfg.pwa.theme_color}
        />
        <link
          rel="icon"
          type="image/png"
          sizes="16x16"
          href={url(cfg.pwa.favicon_16_16)}
        />
        <link
          rel="icon"
          type="image/png"
          sizes="32x32"
          href={url(cfg.pwa.favicon_32_32)}
        />
        <link rel="bookmark" href={url(cfg.pwa.bookmark_icon)} />
      </>
    )}

    <ClientRouter />
    <script
      is:inline
      data-astro-rerun
      set:html={`(${applyInitialTheme.toString()})(${json(cfg.display_mode.type)});`}
    ></script>
    <template id="site-config" set:html={json(runtime)} />
    <template id="config-diff" set:html={json(pageConfig)} />
    {cfg.verify_site.map((html: string) => (
      <Fragment set:html={html} />
    ))}
    {cfg.extends.head.map((html: string) => (
      <Fragment set:html={html} />
    ))}
  </head>
  <body
    class:list={{
      'solitude-memorial':
        cfg.memorial.enable &&
        cfg.memorial.date.includes(
          new Intl.DateTimeFormat('sv-SE', { timeZone: config.timeZone })
            .format(new Date())
            .slice(5),
        ),
    }}
    id="body"
    data-type={type}
    data-search={cfg.search.type}
    data-aside-position={cfg.aside.position}
    data-index-layout={cfg.index_post_list.direction}
  >
    {cfg.loading.fullpage && (
      <div id="loading-box" aria-hidden="true">
        <img src={url(cfg.site.icon)} alt="" />
      </div>
    )}
    {cfg.loading.pace && <div id="navigation-progress" aria-hidden="true" />}
    <a class="skip-link" href="#content-inner">
      {t('startReading')}
    </a>
    <Overlays
      posts={posts}
      toc={toc}
      comments={
        Boolean(cfg.comment.use) &&
        page.comment !== false &&
        ![
          'solitude',
          'about',
          'music',
          'tags',
          'categories',
          'series',
          'brevity',
          'recentcomment',
          'archives',
          'taxonomy',
          'term',
          '404',
        ].includes(type)
      }
    />
    <div
      id="body-wrap"
      class={type === '404' ? 'error' : post ? 'post' : 'page'}
    >
      <Header title={title} post={post} />
      <slot />
      {type !== '404' && <Footer />}
    </div>
    <Search />
    <Capsule />
    <script>
      import '../scripts/entry';
    </script>
    {cfg.extends.body.map((html: string) => (
      <Fragment set:html={html} />
    ))}
  </body>
</html>
